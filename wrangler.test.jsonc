// Solo per i test locali: non pubblica nulla.
{
  "name": "demo-prenotazioni-test",
  "main": "src/index.js",
  "compatibility_date": "2026-11-03",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "vars": { "APP_ENV": "test" },
  "d1_databases": [{ "binding": "DB", "database_name": "test-db", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "FOTO", "bucket_name": "test-foto" }]
}
